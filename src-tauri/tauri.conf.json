{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamSnipe",
  "version": "0.6.2",
  "identifier": "com.streamsnipe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SniperScope",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' wss: https: http:",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "media-src": "'self' blob: mediastream:",
        "script-src": "'self' 'wasm-unsafe-eval'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/kitava.ico"
    ],
    "resources": {},
    "windows": {
      "nsis": {}
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NjNDMDA1Q0JDQkI0RQpSV1JPdTd4Y0FEeDJEaCtZQ3kxbzN2Szd3d1A1dHhiVVlhWVZvbVhqSDY4amtneUxYT2FYVGN3TQo=",
      "endpoints": [
        "https://github.com/afas05/scapp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
