{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "websocket:default",
    "shell:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://streamsnipe.live/api/login"
        },
        {
          "url": "http://localhost/api/login"
        }
      ],
      "deny": [
        {
          "url": "https://private.tauri.app"
        }
      ]
    }
  ]
}